---
import Base from "../layouts/Base.astro";
import Phone from "../components/Phone.astro";
import Mark from "../components/Mark.astro";
import ScreenCompose from "../components/ScreenCompose.astro";
import ScreenItems from "../components/ScreenItems.astro";
import ScreenWhatsApp from "../components/ScreenWhatsApp.astro";
import ScreenHome from "../components/ScreenHome.astro";
import { SITE, waitlist } from "../site";
import { faq } from "../data/faq";
import { orgRef } from "../data/schema";

const title = "Croodit — WhatsApp invoice app with a UPI pay link (India)";
const description =
  "Send a proper invoice on WhatsApp with a UPI pay link in 30 seconds. Croodit tracks who paid and writes the reminder for you. Free forever up to 7 clients.";

const appleSvg =
  "M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.7-3-2-3.7-2-1.6-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.5.9-1.4 1.3-2.7 1.4-2.8-.1 0-2.8-1-2.8-4.1zM14 5c.7-.8 1.2-2 1-3.1-1 .1-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z";
const iosHref = SITE.appStoreUrl ?? waitlist("iPhone");
const iosLabel = SITE.appStoreUrl ? "Download for iPhone" : "Get early access on iPhone";

const audiences = [
  ["zumba 💃", "is-lime"], ["yoga 🧘", ""], ["reels creator 🎬", "is-pink"], ["dance coach 🕺", ""],
  ["personal trainer 🏋️", "is-violet"], ["tutor 📚", ""], ["nutritionist 🥗", ""],
  ["pilates 🤸", "is-ink"], ["photographer 📸", ""], ["makeup artist 💄", ""],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "Croodit",
    url: SITE.url,
    applicationCategory: "BusinessApplication",
    applicationSubCategory: "Invoicing",
    operatingSystem: "iOS",
    inLanguage: ["en-IN", "hi-IN"],
    description,
    featureList: [
      "Send invoices on WhatsApp with a UPI pay link",
      "One-tap payment reminders you approve before sending",
      "Class pack and attendance tracking",
      "Optional GST invoices and monthly CA-ready summaries",
      "Branded invoice PDFs",
    ],
    offers: [
      { "@type": "Offer", name: "Free", price: "0", priceCurrency: "INR",
        description: `Free forever for up to ${SITE.freeClients} clients — unlimited invoices, no card required.` },
      { "@type": "Offer", name: "Croodit Pro (monthly)", price: String(SITE.pro.monthly), priceCurrency: "INR" },
      { "@type": "Offer", name: "Croodit Pro (yearly)", price: String(SITE.pro.yearly), priceCurrency: "INR" },
    ],
    audience: { "@type": "Audience", audienceType: "Fitness trainers, coaches, tutors and creators in India", geographicArea: { "@type": "Country", name: "India" } },
    publisher: orgRef,
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to send an invoice on WhatsApp with Croodit",
    totalTime: "PT30S",
    step: [
      { "@type": "HowToStep", position: 1, name: "Pick the client and the package",
        text: "Your packages are saved once and your clients come from your contacts, so there are no amounts to type." },
      { "@type": "HowToStep", position: 2, name: "Send it on WhatsApp",
        text: "Croodit opens WhatsApp with a written message, the invoice PDF link and a UPI pay link. You press send." },
      { "@type": "HowToStep", position: 3, name: "Track paid, pending and overdue",
        text: "Every invoice shows as paid, pending or overdue. Tap Nudge and the reminder is written for you." },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base title={title} description={description} path="/" schema={schema}>
  <!-- HERO -->
  <section class="wrap hero">
    <div class="hero__copy anim-rise">
      <p class="badge"><span class="dot-live"></span>For trainers, coaches &amp; creators in India</p>
      <h1>Stop chasing clients for fees<span class="dot">.</span></h1>
      <p class="hero__sub">
        Croodit sends your client a proper invoice on WhatsApp with a UPI pay link — in 30 seconds.
        If they forget, one tap nudges them. You never type <i>"payment pending?"</i> again.
      </p>
      <div class="hero__cta">
        <a href={iosHref} class="btn btn--ink">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#D9FF4A" aria-hidden="true"><path d={appleSvg} /></svg>
          {iosLabel}
        </a>
        <p class="hero__fine">Free forever for up to {SITE.freeClients} clients.<br />No card. No GST needed.</p>
      </div>
      <ul class="hero__proof">
        <li><span class="tick">✓</span>Works with the WhatsApp you already use</li>
        <li><span class="tick">✓</span>Any UPI app — GPay, PhonePe, Paytm</li>
      </ul>
    </div>

    <div class="stage stage--hero">
      <div class="blob blob--violet anim-blobA" style="width:420px;height:420px;top:40px;left:50%;margin-left:-160px;opacity:.28"></div>
      <div class="blob blob--pink anim-blobB" style="width:300px;height:300px;bottom:20px;left:50%;margin-left:-40px;opacity:.3"></div>
      <Phone><ScreenCompose /></Phone>
      <div class="float float--dark anim-float" style="right:-10px;top:300px;--r:3deg">
        <span class="avatar" style="width:36px;height:36px;border-radius:50%;background:#25D366;font-size:16px">💸</span>
        <span>
          <span style="display:block;font-weight:700;font-size:14px">Rahul paid ₹4,000</span>
          <span style="display:block;font-size:12px;color:rgba(255,255,255,.6)">via UPI · marked paid</span>
        </span>
      </div>
      <div class="float float--light anim-float" style="left:-14px;bottom:0;--r:-3deg;animation-duration:7s;animation-delay:1s">
        <span style="font:800 22px 'Bricolage Grotesque',serif;letter-spacing:-1px;color:#6B4EFF">28s</span>
        <span style="font-size:12px;line-height:1.3;color:rgba(20,18,24,.65)">from opening the app<br />to invoice sent</span>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="problem">
    <div class="wrap" style="display:flex;flex-direction:column;gap:40px">
      <div style="display:flex;flex-direction:column;gap:12px;max-width:640px">
        <p class="eyebrow">Sound familiar?</p>
        <h2 class="h2">You teach the class. Then you spend the evening being an accountant.</h2>
      </div>
      <div class="grid-3">
        <article class="pcard">
          <p class="pcard__bubble">Hi Rahul, just checking — did you get a chance to pay for Sep? No rush 🙂</p>
          <h3>The awkward ask</h3>
          <p>Typing "payment pending?" to someone you see every morning. Then typing it again next week.</p>
        </article>
        <article class="pcard">
          <div class="ledger">
            <div><span>Sneha · 12‑pack</span><span style="color:#FF8A80">paid?? 🤔</span></div>
            <div><span>Ananya · monthly</span><span style="color:#D9FF4A">cash, I think</span></div>
            <div><span>Vikram · privates</span><span style="color:rgba(255,255,255,.4)">???</span></div>
          </div>
          <h3>Who's actually paid?</h3>
          <p>Scrolling chats, checking GPay, a notes app with 40 names. Money slips through every month.</p>
        </article>
        <article class="pcard">
          <div class="tag-row">
            <span>Screenshot of UPI QR</span><span>Word doc invoice</span><span>"I'll send it later"</span>
          </div>
          <h3>Looking unprofessional</h3>
          <p>Brands and clients ask for a real invoice. You're a trainer, not a CA — but you still need to look like a business.</p>
        </article>
      </div>
      <div class="resolve">
        <strong>Croodit fixes all three.</strong>
        <p>One tap sends a real invoice + pay link on WhatsApp. The app remembers who paid. You go back to teaching.</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="wrap" style="padding-block:90px;display:flex;flex-direction:column;gap:56px">
    <div style="display:flex;flex-direction:column;gap:12px;max-width:640px">
      <p class="eyebrow" style="color:#6B4EFF">How it works</p>
      <h2 class="h2">Three taps. Then WhatsApp does what WhatsApp does.</h2>
    </div>
    <div class="steps">
      <article class="step">
        <div class="step__stage" style="background:#E9E3FF"><Phone scale={0.6}><ScreenItems /></Phone></div>
        <div class="step__text">
          <span class="step__num" style="background:#141218;color:#D9FF4A">1</span>
          <div>
            <h3>Pick the client &amp; the package</h3>
            <p>Your packages are saved once. Client comes from your contacts. No typing amounts.</p>
          </div>
        </div>
      </article>
      <article class="step">
        <div class="step__stage" style="background:#E9FBEF"><Phone scale={0.6}><ScreenWhatsApp /></Phone></div>
        <div class="step__text">
          <span class="step__num" style="background:#25D366;color:#fff">2</span>
          <div>
            <h3>It lands in their WhatsApp with a pay link</h3>
            <p>A friendly message, written for you, plus a link to the PDF and UPI. They pay in the app they already have.</p>
          </div>
        </div>
      </article>
      <article class="step">
        <div class="step__stage" style="background:#FFE3F1"><Phone scale={0.6}><ScreenHome /></Phone></div>
        <div class="step__text">
          <span class="step__num" style="background:#FF6BB5;color:#141218">3</span>
          <div>
            <h3>You always know who's paid — and who needs a nudge</h3>
            <p>Paid, pending, overdue, on one screen. Late? Tap <b>Nudge</b> — the reminder is written and WhatsApp opens. You just hit send.</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- NUDGE -->
  <section class="nudge">
    <div class="wrap nudge__grid">
      <div style="display:flex;flex-direction:column;gap:18px">
        <p class="eyebrow" style="color:#4E33E0">The part you'll love most</p>
        <h2 class="h2">The reminder is written. You just press send.</h2>
        <p class="lede">
          Day 3, day 7, day 10 — Croodit pings <i>you</i>, not your client. Tap the notification, WhatsApp
          opens with a polite message and the pay link already typed. Friendly, formal, or Hindi — your tone,
          your call. Never a bot texting your clients behind your back.
        </p>
        <ul class="nudge__list">
          <li><span class="tick tick--ink">✓</span>Pay link means no "send me your UPI ID again"</li>
          <li><span class="tick tick--ink">✓</span>Cash or GPay direct? Tap "Mark paid". Done.</li>
          <li><span class="tick tick--ink">✓</span>Packs, attendance &amp; renewals tracked automatically</li>
        </ul>
      </div>
      <div style="display:flex;flex-direction:column;gap:14px;max-width:440px;margin-left:auto;width:100%">
        <div class="notif">
          <span class="linkcard__tile"><Mark id="n1" /></span>
          <span style="flex:1">
            <span style="display:flex;justify-content:space-between;font-size:12px;color:rgba(20,18,24,.5)">
              <b style="color:#141218">Croodit</b><span>6:00 pm</span>
            </span>
            <span style="display:block;font-size:14px;margin-top:2px;line-height:1.4">Vikram's ₹2,500 is 3 days late. <b>Tap to nudge on WhatsApp →</b></span>
          </span>
        </div>
        <div style="align-self:center;font-size:20px;color:rgba(20,18,24,.35)" aria-hidden="true">↓</div>
        <div class="chat" style="border-radius:22px;padding:16px">
          <p class="bubble" style="max-width:92%;font-size:14px">
            Hey Vikram! Quick one — invoice for Sep Monthly (₹2,500) is waiting 💛 Pay here:
            <span style="color:#0b7bd6;text-decoration:underline">croodit.com/pay/0139</span>
            <span class="bubble__time" style="display:block">6:02 pm</span>
          </p>
          <div style="display:flex;gap:8px;align-items:center;width:100%;margin-top:4px">
            <div style="flex:1;height:40px;border-radius:20px;background:#fff;display:flex;align-items:center;padding:0 14px;font-size:13px;color:#999">Message</div>
            <div class="avatar" style="width:40px;height:40px;border-radius:50%;background:#25D366;color:#fff;font-size:14px;font-weight:800">➤</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO -->
  <section id="who" class="wrap who">
    <h2 class="h2" style="max-width:720px">Built for anyone who gets paid by people, not payroll.</h2>
    <p class="lede" style="max-width:560px;font-size:17px">
      Monthly packs, class bundles, drop‑ins, retainers, one‑off shoots — Croodit pre‑fills your menu based on what you do.
    </p>
    <ul class="pills">{audiences.map(([label, cls]) => <li class={cls}>{label}</li>)}</ul>
    <p class="lede" style="max-width:640px;font-size:16px">
      Your month has its own shape. See it spelled out for
      <a href="/for/zumba-trainers" style="font-weight:600">Zumba trainers</a>,
      <a href="/for/yoga-teachers" style="font-weight:600">yoga teachers</a> and
      <a href="/for/tutors" style="font-weight:600">tutors</a> — or
      <a href="/for" style="font-weight:600">everyone Croodit is built for</a>.
    </p>
    <div class="feats">
      <article class="feat">
        <p class="feat__icon">₹</p>
        <h3>Rupees &amp; UPI native</h3>
        <p>Pay link + QR. GST optional — on only if you need it.</p>
      </article>
      <article class="feat">
        <p class="feat__icon">✅</p>
        <h3>Attendance &amp; packs</h3>
        <p>Tick who showed up. Know when a 12‑pack runs out before they do.</p>
      </article>
      <article class="feat">
        <p class="feat__icon">🎨</p>
        <h3>Looks like your brand</h3>
        <p>Your logo and colour on every invoice. Bold, minimal or playful.</p>
      </article>
      <article class="feat">
        <p class="feat__icon">🔒</p>
        <h3>Your WhatsApp, your voice</h3>
        <p>Nothing sends without you. No bots, no business‑API, no spam.</p>
      </article>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="wrap faq">
    <div style="display:flex;flex-direction:column;gap:12px;max-width:640px">
      <p class="eyebrow" style="color:#6B4EFF">Questions</p>
      <h2 class="h2">Everything people ask before they switch</h2>
    </div>
    <div class="faq__list">
      {faq.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
    <p style="max-width:640px;font-size:16px;color:var(--t-70)">
      Doing it by hand right now? Read
      <a href="/answers/how-to-send-an-invoice-on-whatsapp" style="font-weight:600">how to send an invoice on WhatsApp with a UPI payment link</a>
      — the free method, step by step. Weighing up billing software instead? We compared them in
      <a href="/vyapar-alternative-for-trainers-and-coaches" style="font-weight:600">Vyapar alternative for trainers and coaches</a>.
      Dreading the follow-up message itself? Here's
      <a href="/answers/how-to-ask-a-client-for-payment-politely" style="font-weight:600">how to ask a client for payment politely</a>
      — the exact words for day 3, day 7 and day 10. Worried that moving off cash puts you on someone's radar?
      <a href="/answers/will-i-get-a-gst-notice-for-taking-fees-on-upi" style="font-weight:600">will I get a GST notice for taking fees on UPI?</a>
      has the threshold that actually applies to a trainer. Want it in your own terms? Start with
      <a href="/for" style="font-weight:600">who Croodit is built for</a>.
    </p>
  </section>

  <!-- FINAL CTA -->
  <section id="get" class="wrap final">
    <div class="final__box">
      <div class="blob blob--violet anim-blobA" style="width:520px;height:520px;top:-260px;right:-160px;filter:blur(60px);opacity:.7"></div>
      <div class="blob blob--pink anim-blobB" style="width:380px;height:380px;bottom:-200px;left:-120px;opacity:.55"></div>
      <div class="final__logo"><Mark id="f1" width={50} /></div>
      <h2>Send your next invoice in 30 seconds. <span>Croodit.</span></h2>
      <p>Free forever for up to {SITE.freeClients} clients. Set up takes two minutes — your packages, your UPI, your logo.</p>
      <div class="final__cta">
        <a href={iosHref} class="btn btn--lime">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#141218" aria-hidden="true"><path d={appleSvg} /></svg>
          {iosLabel}
        </a>
        <a href={SITE.playStoreUrl ?? waitlist("Android")} class="btn btn--glass">Android — join the waitlist</a>
      </div>
    </div>
  </section>
</Base>
