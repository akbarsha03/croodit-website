---
interface Props { light?: boolean; height?: number; class?: string }
const { light = false, height = 26, class: cls = "" } = Astro.props;
// The "oo" of "croodit" is the ring mark — see brand/README.md.
const ringW = Math.round(height * 1.37);
const ringH = Math.round((ringW / 96) * 56);
const back = light ? "#FFFFFF" : "#141218";
---

<span class:list={["wordmark", light && "wordmark--light", cls]} style={`font-size:${height}px`}>
  <span>cr</span>
  <svg width={ringW} height={ringH} viewBox="0 0 96 56" role="presentation" aria-hidden="true">
    <defs>
      <clipPath id={`ring-${height}${light ? "-l" : ""}`}><rect x="0" y="28" width="96" height="28" /></clipPath>
    </defs>
    <circle cx="33" cy="28" r="22" fill="none" stroke="#6B4EFF" stroke-width="10" />
    <circle cx="63" cy="28" r="22" fill="none" stroke={back} stroke-width="10" />
    <circle cx="33" cy="28" r="22" fill="none" stroke="#6B4EFF" stroke-width="10" clip-path={`url(#ring-${height}${light ? "-l" : ""})`} />
  </svg>
  <span>dit</span>
</span>
