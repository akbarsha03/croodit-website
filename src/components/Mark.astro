---
/* Ring mark only — lime + white on dark tiles. */
interface Props { width?: number; id?: string; secondary?: string }
const { width = 30, id = "m", secondary = "#fff" } = Astro.props;
---
<svg width={width} height={Math.round((width / 96) * 56)} viewBox="0 0 96 56" role="presentation" aria-hidden="true">
  <defs><clipPath id={`mk-${id}`}><rect x="0" y="28" width="96" height="28" /></clipPath></defs>
  <circle cx="33" cy="28" r="22" fill="none" stroke="#D9FF4A" stroke-width="11" />
  <circle cx="63" cy="28" r="22" fill="none" stroke={secondary} stroke-width="11" />
  <circle cx="33" cy="28" r="22" fill="none" stroke="#D9FF4A" stroke-width="11" clip-path={`url(#mk-${id})`} />
</svg>
